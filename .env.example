# TeachMate AI environment variables
#
# Copy to .env.local for local development:   cp .env.example .env.local
# .env.local is git-ignored. Never commit real keys.
#
# Development values come from the hosted development project's dashboard (Project Settings → API
# Keys); there is no local Supabase stack. Production values also come from the Supabase dashboard (Project Settings → API Keys) and are set in
# Vercel → Project → Settings → Environment Variables, separately for Preview and Production.

# ---------------------------------------------------------------------------
# Public (inlined into the browser bundle at BUILD time — safe to expose)
# ---------------------------------------------------------------------------

# Supabase project URL: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). Access is governed by Row Level Security.
# NEVER put the secret key or the legacy service_role key here — the app refuses to start if you do.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public URL of this app, used to build auth email redirect links (<SITE_URL>/auth/confirm).
# Must match the Supabase Auth "Site URL" / "Redirect URLs" configured for the project.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Server-only (never prefix with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------

# Secret key (sb_secret_...). Bypasses Row Level Security. Used only by src/lib/supabase/admin.ts.
# Leave empty until a feature needs it; it is validated when the admin client is first created.
SUPABASE_SECRET_KEY=

# Shared secret for the daily maintenance cron (GET /api/internal/maintenance).
# Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`. At least 32 characters;
# while it is unset (or shorter), the endpoint rejects every request with 401.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Run maintenance locally:  curl -H "Authorization: Bearer $CRON_SECRET" http://localhost:3000/api/internal/maintenance
CRON_SECRET=

# ---------------------------------------------------------------------------
# Added in later phases (not used yet)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=       # Phase 5: AI generation (server-only)
